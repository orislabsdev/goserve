# Copia a server.env y ajusta valores (no commitear server.env)

SERVER_HOST=127.0.0.1
SERVER_PORT=8090
DOMAIN=example.com

TLS_CERT_FILE=
TLS_KEY_FILE=
ADMIN_EMAIL=admin@example.com

BACKEND_URL=http://127.0.0.1:4000

# WebSocket opcional: misma ruta que expone tu backend (gocore, etc.).
# Debe contener "ws" (/ws, /api/ws, /websocket). Vacío = sin proxy WS.
WS_PATH=/ws

RATE_LIMIT_ENABLED=true
RATE_LIMIT=50
RATE_BURST=100

REQUIRE_CLOUDFLARE=false

STATIC_DIR=./dist/spa

DEV_MODE=true
